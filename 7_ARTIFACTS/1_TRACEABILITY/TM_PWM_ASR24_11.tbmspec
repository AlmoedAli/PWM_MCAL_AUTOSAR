        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucIntegerParamDef PwmIndex</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00142" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucBooleanParamDef PwmLowPowerStates Support</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00133" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucBooleanParamDef PwmNotificationSupported</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00134" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucBooleanParamDef PwmPeriodUpdated Endperiod</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00143" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucBooleanParamDef PwmPowerState AsynchTransitionMode</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00149" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucReferenceDef PwmEcucPartitionRef</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00150" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucReferenceDef PwmKernelEcucPartition Ref</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="SWS_Pwm_CONSTR_00001" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>The ECUC partitions referenced by PwmKernelEcucPartitionRef shall be a subset of the ECUC partitions referenced by PwmEcucPartitionRef.</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="SWS_Pwm_CONSTR_00002" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>If PwmEcucPartitionRef references one or more ECUC partitions, PwmKernelEcucPartitionRef shall have a multiplicity of one and reference one of these ECUC partitions as well.</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00144" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucParamConfContainerDef PwmPowerState Config</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00146" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucIntegerParamDef PwmPowerState</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
