        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00147" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucReferenceDef PwmMcuClockReference Point</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="SWS_Pwm_CONSTR_00003" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>If PwmEcucPartitionRef references one or more ECUC partitions, PwmChannelEcucPartitionRef shall have a multiplicity of greater than zero and reference one or several of these ECUC partitions as well.</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00140" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucParamConfContainerDef PwmChannel ConfigSet</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00126" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucParamConfContainerDef PwmConfigurationOfOptApiServices</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00141" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
        <AssignedTo first="admin" last="admin"/>
        <Body>Definition of EcucBooleanParamDef PwmDeInitApi</Body>
        <Tag name="Import from Word: 06/15/26 16:22:54"/>
    </Requirement>
    <Requirement group="AUTOSAR_CP_SWS_PWMDriver.pdf" type="System" name="" number="ECUC_Pwm_00127" document="U:\0_SWS\AUTOSAR_CP_SWS_PWMDriver.pdf">
