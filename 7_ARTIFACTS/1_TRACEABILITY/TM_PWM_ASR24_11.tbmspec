    <Program name="Command Line" path="$(Cmd)" opens="bat, sh" startin="$(Filedir)" detached="n" autorun="" automatable="n">
        <CommandLine>/C &quot;$(Filepath)&quot;</CommandLine>
    </Program>
    <Program name="LDRA GLH Information" path="$(TBeddir)\glh_compare_dlg.exe" opens="ldra" startin="$(Workarea)" detached="n" autorun="" automatable="n">
        <CommandLine>&quot;$(Filepath)&quot;</CommandLine>
    </Program>
    <Program name="TBmanager Internal" path="$(TbmInternal)" opens="tbmspec" startin="$(CWD)" detached="n" autorun="" automatable="n">
        <CommandLine>&quot;$(Filepath)&quot;</CommandLine>
    </Program>
    <Program name="PDF at Page" path="$(PdfReader)" opens="pdf@section" startin="$(CWD)" detached="n" autorun="" automatable="n">
        <CommandLine>/A &quot;page=$(Section)&quot; &quot;$(Filepath)&quot;</CommandLine>
    </Program>
    <Program name="Remote PDF at Page" path="$(DefaultBrowser)" opens="pdf@section" startin="$(CWD)" detached="n" autorun="" automatable="n">
        <CommandLine>&quot;$(Filepath)#page=$(Section)&quot;</CommandLine>
    </Program>
    <Program name="HTML at Anchor" path="$(DefaultBrowser)" opens="htm@section, html@section" startin="$(CWD)" detached="n" autorun="" automatable="n">
        <CommandLine>&quot;file:///$(Filepath)#$(Section)&quot;</CommandLine>
    </Program>
    <Program name="Word Document Bookmark" path="$(TBeddir)\LdraWord.exe" opens="doc@section, docx@section" startin="$(CWD)" detached="n" autorun="" automatable="n">
        <CommandLine>&quot;$(Filepath)&quot; /open_at_bookmark=$(Section)</CommandLine>
    </Program>
    <Program name="Word Document At Text" path="$(TBeddir)\LdraWord.exe" opens="doc@section, docx@section" startin="$(CWD)" detached="n" autorun="" automatable="n">
        <CommandLine>&quot;$(Filepath)&quot; &quot;/open_at_text=$(Section)&quot;</CommandLine>
    </Program>
    <Program name="Excel Open to Cell or Range" path="$(TBeddir)\LdraWord.exe" opens="xls@section, xlsx@section" startin="$(CWD)" detached="n" autorun="" automatable="n">
        <CommandLine>&quot;$(Filepath)&quot; /open_at_cell=$(Section)</CommandLine>
    </Program>
